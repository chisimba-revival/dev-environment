#!/usr/bin/env bash
set -euo pipefail

config_file="${CHISIMBA_AI_WORKER_CONFIG:-/etc/chisimba/ai-worker.conf}"
if [[ -r "$config_file" ]]; then
    # The installer writes this root-owned file using shell-safe quoted values.
    # shellcheck disable=SC1090
    source "$config_file"
fi

container_name="${CHISIMBA_CONTAINER_NAME:-chisimba-web}"
worker_path="${CHISIMBA_WORKER_PATH:-/var/www/html/ch/modules/mcqtests/scripts/run_chapter_quiz_worker.php}"
docker_binary="${CHISIMBA_DOCKER_BINARY:-/usr/bin/docker}"

if [[ ! -x "$docker_binary" ]]; then
    echo "Docker is not executable at $docker_binary." >&2
    exit 69
fi
if [[ "$("$docker_binary" inspect --format '{{.State.Running}}' "$container_name" 2>/dev/null || true)" != "true" ]]; then
    echo "AI worker skipped: $container_name is not running."
    exit 0
fi

exec /usr/bin/flock --nonblock /run/chisimba-ai-worker.lock \
    "$docker_binary" exec "$container_name" php "$worker_path"
